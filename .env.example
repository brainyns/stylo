# Copia este archivo como .env y ajusta los valores.

# Base de datos (docker-compose)
POSTGRES_DB=stylo
POSTGRES_USER=stylo
POSTGRES_PASSWORD=stylo_dev

# JWT (HS256, mínimo 32 caracteres). Genera uno propio con: openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
